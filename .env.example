# ==============================================================
# Shikhar360 Root Environment Example
# Copy this file to .env and configure as needed
# ==============================================================

# Backend Server Configuration
PORT=5000
NODE_ENV=development
JWT_SECRET=your_jwt_secret_key_here
CLIENT_URL=http://localhost:5173,http://127.0.0.1:5173

# Database Settings (Backend)
DB_DIALECT=sqlite
DB_STORAGE=./server/shikhar360.sqlite

# MySQL Database Settings (optional alternative to SQLite)
# DB_DIALECT=mysql
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=shikhar360_db
# DB_USER=root
# DB_PASS=

# Frontend Client Configuration
VITE_API_URL=http://localhost:5000/api
VITE_APP_NAME=Shikhar360
VITE_APP_DESCRIPTION=India's Premier Education Discovery & Admission Platform
